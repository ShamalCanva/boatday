# Apple WeatherKit (server-side only — never expose these to the client)
# Team ID: found in developer.apple.com/account → Membership
APPLE_WEATHERKIT_TEAM_ID=
# Key ID: from the WeatherKit-enabled key you generate under Certificates, Identifiers & Profiles → Keys
APPLE_WEATHERKIT_KEY_ID=
# Service ID (aka "sub"): the identifier you registered for this WeatherKit-enabled app/site,
# e.g. vision.coconut.boatdayguide
APPLE_WEATHERKIT_SERVICE_ID=
# The full contents of the .p8 private key file Apple gives you when you create the key.
# Paste it as a single line with literal "\n" for line breaks, e.g.:
# "-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
APPLE_WEATHERKIT_PRIVATE_KEY=

# Apple Maps Web Snapshots — powers the real map preview on the Get There
# page. Reuses APPLE_WEATHERKIT_TEAM_ID above (same Apple Developer account),
# just needs its own Maps-scoped key.
# Key ID: from a key with the "MapKit JS" service enabled, associated with a
# Maps ID (Certificates, Identifiers & Profiles → Identifiers → Maps IDs)
APPLE_MAPS_KEY_ID=
# The full contents of that key's .p8 file, same "\n"-escaped format as above.
APPLE_MAPS_PRIVATE_KEY=
